  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Tajawal:wght@400;500;700;800&display=swap">
  <style>
    :root {
      --bg: #F4EDE4; --card: #FFFFFF; --ink: #1F2A4A; --muted: #6B7186;
      --clay: #B47C5E; --line: #E6DACD; --blue: #3461C9;
      --display: 'Amiri', 'Times New Roman', serif;
      --body: 'Tajawal', 'Segoe UI', Tahoma, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body {
      min-height: 100vh; background: var(--bg); color: var(--ink);
      font-family: var(--body); -webkit-font-smoothing: antialiased;
      display: flex; justify-content: center;
    }
    main {
      width: 100%; max-width: 480px;
      padding: max(40px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left));
      display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center;
    }
    .brand { display: grid; place-items: center; }
    .brand img { position: relative; width: 210px; height: auto; }
    h1 { font-family: var(--display); font-size: 36px; line-height: 1.2; margin: 0; }
    .tagline { margin: -16px 0 0; color: var(--clay); font-weight: 700; font-size: 16px; }
    ul { list-style: none; margin: 0; padding: 0; width: 100%; display: flex; flex-direction: column; gap: 12px; }
    .member {
      display: flex; align-items: center; gap: 14px; padding: 14px 16px;
      background: var(--card); border-radius: 18px; color: var(--ink); text-decoration: none;
      box-shadow: 0 1px 0 var(--line), 0 8px 24px -18px rgba(31, 42, 74, .5);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .member:hover { transform: translateY(-2px); box-shadow: 0 1px 0 var(--line), 0 14px 28px -18px rgba(31, 42, 74, .6); }
    .member:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
    .avatar {
      flex: none; width: 50px; height: 50px; border-radius: 50%;
      border: 1.5px solid var(--ink); display: grid; place-items: center; position: relative;
      font-family: var(--display); font-size: 24px; line-height: 1; padding-top: 4px;
    }
    .avatar::after {
      content: ""; position: absolute; top: 1px; left: 3px; width: 10px; height: 10px;
      border-radius: 50%; background: var(--clay);
    }
    .name { flex: 1; min-width: 0; text-align: right; font-size: 19px; font-weight: 800; }
    .go {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px;
      background: #EEF2FB; color: var(--blue); font-size: 13px; font-weight: 700;
    }
    .go svg { width: 16px; height: 16px; }
    footer { display: flex; flex-direction: column; gap: 4px; color: var(--muted); font-size: 13px; line-height: 1.6; }
    @media (prefers-reduced-motion: reduce) { .member { transition: none; } }
  </style>
